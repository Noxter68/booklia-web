      "trust": "Trust",
      "trustDesc": "Our reputation system ensures transparent and secure exchanges between all members.",
      "community": "Community",
      "communityDesc": "We believe in the power of the collective and encourage authentic human connections.",
      "kindness": "Kindness",
      "kindnessDesc": "Every interaction is an opportunity for mutual help and sharing skills.",
      "simplicity": "Simplicity",
      "simplicityDesc": "An intuitive platform where finding or offering a service takes just a few clicks."
    },
    "story": {
      "title": "Our story",
      "p1": "Booklia was born from a simple observation: in our daily lives, we often need help with various tasks - from DIY to tutoring, from gardening to tech support. And around us, talented people would be happy to offer their services.",
      "p2": "We wanted to create a space where these connections happen naturally, in a trusted environment. Our innovative reputation system, inspired by video game progression mechanics, makes the experience engaging while ensuring the quality of exchanges.",
      "p3": "Today, Booklia grows thanks to you, our community. Every service exchanged strengthens our conviction: together, we can create a more human and supportive local economy."
    },
    "team": {
      "name": "The Booklia Team",
      "role": "Founders",
      "description": "A team passionate about the collaborative economy and human connections."
    }
