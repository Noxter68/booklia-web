  "about": {
    "title": "About us",
    "intro": "Booklia was born from a simple idea: making service exchanges between individuals easier in a trusted environment. We believe everyone has valuable skills to share.",
    "mission": {
      "badge": "Our mission",
      "title": "Connecting local talent",
      "description1": "We created Booklia to meet a simple need: helping everyone easily find help for their everyday projects, while offering local talent a platform to showcase their skills.",
      "description2": "Our unique reputation system, based on experience and trust, ensures smooth exchanges and encourages excellence.",
